# ============================================================
# 复制为 .env 后按需修改。默认配置在装有 Ollama 的机器上可直接跑。
#
# 本项目支持两条模型接入路径，都能跑通，任选其一即可：
#   A. 本地 Ollama   —— 零密钥、零费用、断网可用（推荐先用这条）
#   B. 云端 API Key  —— 任何 OpenAI 兼容端点，效果更好、不吃本机显存
# 具体操作步骤见 README「模型接入：本地与云端两条路」一节。
# ============================================================

# ---------------- 模型后端 ----------------
# auto      ：先探本地 Ollama，没有可用模型再回退云端（默认）
# ollama    ：只用本地
# cloud     ：只用云端（dashscope / openai / api 是它的别名）
LLM_PROVIDER=auto

# 指定模型名，留空则按内置优先级自动挑选
# 本地示例：qwen3:8b / qwen2.5-coder-7b-local:latest
# 云端示例：qwen-turbo / qwen-plus / deepseek-chat / gpt-4o-mini
# LLM_MODEL=

# 默认温度。要稳定复现的用例（诊断、换算）自己在代码里传 0.0~0.1
LLM_TEMPERATURE=0.2

# ---------------- A. 本地 Ollama ----------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 探测超时（秒）：服务没起时不该让每条命令都等很久
OLLAMA_TIMEOUT=2

# ---------------- B. 云端 API（OpenAI 兼容协议）----------------
# 默认端点 = 阿里云百炼兼容模式；换厂商只改这一行，代码不用动：
#   DeepSeek       https://api.deepseek.com/v1
#   Kimi moonshot  https://api.moonshot.cn/v1
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4
#   硅基流动        https://api.siliconflow.cn/v1
#   OpenAI 官方     https://api.openai.com/v1
# CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 云端密钥。留空则回退读下面的 DASHSCOPE_API_KEY（老配置不用改）
CLOUD_API_KEY=
CLOUD_MODEL=qwen-turbo
# 单次请求超时（秒）。云端偶尔很慢，但也不该无限等
CLOUD_TIMEOUT=60

# 兼容老变量名：只写这两项也能用云端
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo

# ---------------- Web 界面 ----------------
# 界面默认只监听 127.0.0.1（本机可访问）。改成 0.0.0.0 会让同一局域网内
# 其他设备也能打开 —— 注意本项目没有登录鉴权，公共网络下不要这么配。
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ---------------- 工具 ----------------
# 填了走 SerpAPI；留空则用 Bing / DuckDuckGo 免密钥检索
SERPAPI_API_KEY=

# 1 = 网络诊断工具返回模拟数据（离线演示 Agent 调度用，输出带 [模拟] 前缀）
NET_DIAG_MOCK=0

# 1 = 搜索/工具失败时打印各渠道的失败原因，排查用
DEBUG_TOOLS=0

# ---------------- 交互 ----------------
# 1 = 产品顾问保留多轮记忆，0 = 每轮独立
MEMORY=0
