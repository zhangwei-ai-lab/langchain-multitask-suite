# ============================================================
# 复制为 .env 后按需修改。默认配置在装有 Ollama 的机器上可直接跑。
# ============================================================

# ---------------- 模型后端 ----------------
# auto      ：先探本地 Ollama，没有可用模型再回退 DashScope（默认）
# ollama    ：只用本地
# dashscope ：只用阿里云百炼
LLM_PROVIDER=auto

# 指定模型名，留空则按内置优先级自动挑选
# 本地示例：qwen3:8b / qwen2.5-coder-7b-local:latest
# 云端示例：qwen-turbo / qwen-plus / deepseek-v3
# LLM_MODEL=

# 默认温度。要稳定复现的用例（诊断、换算）自己在代码里传 0.0~0.1
LLM_TEMPERATURE=0.2

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=2

# 仅在需要云端后端时填写
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo

# ---------------- 工具 ----------------
# 填了走 SerpAPI；留空则用 Bing / DuckDuckGo 免密钥检索
SERPAPI_API_KEY=

# 1 = 网络诊断工具返回模拟数据（离线演示 Agent 调度用，输出带 [模拟] 前缀）
NET_DIAG_MOCK=0

# 1 = 搜索/工具失败时打印各渠道的失败原因，排查用
DEBUG_TOOLS=0

# ---------------- 交互 ----------------
# 1 = 产品顾问保留多轮记忆，0 = 每轮独立
MEMORY=0
